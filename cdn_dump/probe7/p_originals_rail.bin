<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Сервер недоступен</title>
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0d0d0d;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      color: #e0e0e0;
    }

    .container {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 32px;
      text-align: center;
      padding: 40px 24px;
    }

    .logo-wrap {
      width: 96px;
      height: 96px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .logo-wrap svg {
      width: 96px;
      height: 96px;
      transform-origin: 60% 60%;
      animation: spin 2s linear infinite;
    }

    @keyframes spin {
      from { transform: rotate(0deg); }
      to   { transform: rotate(360deg); }
    }

    .main-text {
      font-size: clamp(18px, 4vw, 28px);
      font-weight: 600;
      letter-spacing: -0.02em;
      color: #f0f0f0;
      max-width: 480px;
      line-height: 1.4;
    }

    .sub-text {
      font-size: 13px;
      color: #666;
      letter-spacing: 0.01em;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="logo-wrap">
      <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="100" height="100" rx="22" fill="#D97757"/>
        <path d="M62 28 L38 72" stroke="white" stroke-width="9" stroke-linecap="round"/>
        <path d="M45 28 C45 28 28 28 28 50 C28 72 45 72 45 72" stroke="white" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      </svg>
    </div>

    <p class="main-text">Разработчики продлевают подписку на AI</p>

    <p class="sub-text">(перезагрузите страницу, сервер поднимается)</p>
  </div>

  <script>
    (function poll() {
      setTimeout(function () {
        fetch(window.location.href, { method: 'GET', cache: 'no-store' })
          .then(function (res) {
            if (res.status !== 503) {
              window.location.reload();
            } else {
              poll();
            }
          })
          .catch(poll);
      }, 5000);
    })();
  </script>
</body>
</html>
